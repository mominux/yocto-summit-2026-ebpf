[Unit]
Description=Demo: load and pin Netguard cgroup/connect4 BPF program
# systemd mounts bpffs as an API filesystem; it may not expose a mount unit.
AssertPathIsMountPoint=/sys/fs/bpf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@SBINDIR@/bpftool prog loadall @LIBDIR@/bpf/netguard.bpf.o /sys/fs/bpf/netguard pinmaps /sys/fs/bpf/netguard
# Zero map value means the BPF program's default blocked port (8080).
ExecStop=-/bin/rm -rf /sys/fs/bpf/netguard

[Install]
WantedBy=multi-user.target
